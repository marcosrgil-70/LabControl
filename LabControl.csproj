<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>labcontrol-v2-0b6c1d2e</UserSecretsId>
    <!-- versão exibida no menu (Infra/Versao.cs) -->
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy/ = código v1 (referência para reescrever as telas); tests/ e tools/ têm projeto/ferramenta próprios -->
    <Compile Remove="Legacy/**;tests/**;tools/**" />
    <Content Remove="Legacy/**;tests/**;tools/**" />
    <None Remove="Legacy/**;tests/**;tools/**" />
    <EmbeddedResource Remove="Legacy/**;tests/**;tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 9.x alinhado com Pomelo 9.x. Sem migrations: o schema é Scripts/v2/*.sql -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

</Project>
