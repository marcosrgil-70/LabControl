@model PainelVM
@{
    ViewData["Title"] = "Início";
}

<div class="mb-4">
    <h5 class="mb-0"><i class="bi bi-house me-2 text-primary"></i>Painel</h5>
    <small class="text-muted">@Model.EmpresaNome</small>
</div>

@if (Model.Contadores.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
            Nenhum indicador disponível para o seu perfil nesta empresa.
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model.Contadores)
        {
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100 painel-contador">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi @c.Icone fs-2 text-@c.Cor"></i>
                            <div>
                                <div class="fs-3 fw-bold lh-1">
                                    @if (c.Href is not null)
                                    {
                                        <a href="@c.Href" class="text-reset text-decoration-none stretched-link">@c.Valor</a>
                                    }
                                    else
                                    {
                                        @c.Valor
                                    }
                                </div>
                                <div class="small fw-semibold">@c.Titulo</div>
                                @if (c.Detalhe is not null)
                                {
                                    <div class="small text-muted">@c.Detalhe</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
