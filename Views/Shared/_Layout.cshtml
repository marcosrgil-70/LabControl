<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LabControl</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Topo: empresa ativa, profissional e "trocar empresa" entram na 1.1/1.2 (T00/T01), lidos das claims *@
    <nav class="navbar navbar-dark topbar px-3 py-2">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-flask me-2"></i>LabControl
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="ms-auto d-flex align-items-center gap-3">
                <span class="text-white-50 small"><i class="bi bi-person-circle me-1"></i>@User.Identity.Name</span>
            </div>
        }
    </nav>

    <div class="d-flex">
        @* Menu: só telas já reescritas. O menu completo da T01, filtrado por permissão, é a tarefa 1.2 *@
        <div class="sidebar">
            <nav class="d-flex flex-column py-2">
                <span class="nav-section">Principal</span>
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house me-2"></i>Início
                </a>
            </nav>
        </div>

        <main class="content-wrapper flex-grow-1">
            @if (TempData[Mensagens.Sucesso] is { } sucesso)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@sucesso
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }
            @if (TempData[Mensagens.Erro] is { } erro)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@erro
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
