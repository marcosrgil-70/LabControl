<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LabControl</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Topo (T00/T01): empresa ativa sempre visível, menu do usuário com trocar empresa/senha e sair *@
    <nav class="navbar navbar-dark topbar px-3 py-2">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-flask me-2"></i>LabControl
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="ms-auto d-flex align-items-center gap-3">
                @if (User.FindFirst(LabClaims.EmpresaCodigo) is { } codigo)
                {
                    <a asp-controller="Conta" asp-action="Empresa" class="text-white small text-decoration-none topbar-empresa" title="Trocar empresa">
                        <i class="bi bi-building me-1"></i><strong>@codigo.Value</strong> — @User.FindFirst(LabClaims.EmpresaNome)?.Value
                    </a>
                }
                <div class="dropdown">
                    <button class="btn btn-link text-white-50 small text-decoration-none dropdown-toggle p-0" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Conta" asp-action="Empresa"><i class="bi bi-building me-2"></i>Trocar empresa</a></li>
                        <li><a class="dropdown-item" asp-controller="Conta" asp-action="TrocarSenha"><i class="bi bi-key me-2"></i>Trocar senha</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Conta" asp-action="Sair" method="post">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sair</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </nav>
    @if (User.Identity?.IsAuthenticated == true && User.HasClaim(c => c.Type == LabClaims.EmpresaId) && !User.HasClaim(c => c.Type == LabClaims.ProfissionalId))
    {
        <div class="alert alert-warning rounded-0 border-0 border-bottom py-2 px-3 mb-0 small" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>Usuário sem profissional vinculado nesta empresa — não poderá receber amostras, lançar resultados nem gerar boletins.
        </div>
    }

    <div class="d-flex">
        @* Menu da T01: itens filtrados por permissão e só de telas já reescritas (Infra/Menu.cs) *@
        <div class="sidebar d-flex flex-column">
            <nav class="d-flex flex-column py-2">
                @await Component.InvokeAsync("Menu")
            </nav>
            <div class="sidebar-versao mt-auto px-3 py-2" title="Sobre o sistema">LabControl @Versao.Atual</div>
        </div>

        <main class="content-wrapper flex-grow-1">
            @if (TempData[Mensagens.Sucesso] is { } sucesso)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@sucesso
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }
            @if (TempData[Mensagens.Erro] is { } erro)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@erro
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
