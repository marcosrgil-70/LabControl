@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="card">
    <div class="card-body">
        <h5 class="text-danger"><i class="bi bi-exclamation-octagon me-2"></i>Ocorreu um erro ao processar a solicitação.</h5>
        <p class="mb-0 text-muted">Tente novamente. Se o problema continuar, informe ao suporte o código abaixo.</p>
        @if (Model.ShowRequestId)
        {
            <p class="mt-3 mb-0"><strong>Código:</strong> <code>@Model.RequestId</code></p>
        }
    </div>
</div>
