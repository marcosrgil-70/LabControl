@model SenhaProvisoriaVM
@{
    ViewData["Title"] = "Senha provisória";
}

<div class="card" style="max-width: 560px">
    <div class="card-body">
        <h5 class="mb-3"><i class="bi bi-key me-2 text-primary"></i>@(Model.Inclusao ? "Usuário incluído" : "Senha resetada")</h5>
        <p class="mb-2">Senha provisória do usuário <strong>@Model.Login</strong>:</p>
        <div class="input-group mb-2">
            <input id="senha-provisoria" class="form-control font-monospace fs-5" value="@Model.Senha" readonly />
            <button type="button" class="btn btn-outline-primary" onclick="navigator.clipboard.writeText(document.getElementById('senha-provisoria').value); this.innerText = 'Copiada';">Copiar</button>
        </div>
        <div class="alert alert-warning small py-2 mb-3">
            <i class="bi bi-exclamation-triangle me-1"></i>Ela é exibida <strong>somente agora</strong> e não fica guardada. Entregue ao usuário: ele deverá trocá-la no primeiro acesso.
        </div>
        <a asp-action="Editar" asp-route-id="@Model.IdUsuario" class="btn btn-primary btn-sm">Ver usuário</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Voltar à lista</a>
    </div>
</div>
