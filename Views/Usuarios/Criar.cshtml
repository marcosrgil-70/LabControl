@model LabControl.Models.UsuarioEditVM
@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-person-plus me-2 text-primary"></i>Novo Usuário</h5>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
</div>

<form asp-action="Criar" method="post">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-person me-2"></i>Dados do Usuário</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Codigo" class="form-label">Código (Login)</label>
                    <input asp-for="Codigo" class="form-control text-uppercase" placeholder="Ex: JOAO.SILVA" maxlength="30" />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Nome" class="form-label">Nome Completo</label>
                    <input asp-for="Nome" class="form-control" placeholder="Nome do usuário" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="NovaSenha" class="form-label">Senha</label>
                    <input asp-for="NovaSenha" type="password" class="form-control" />
                    <span asp-validation-for="NovaSenha" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="ConfirmarSenha" class="form-label">Confirmar Senha</label>
                    <input asp-for="ConfirmarSenha" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsAdmin" class="form-check-input" id="chkIsAdmin" />
                        <label class="form-check-label" for="chkIsAdmin">
                            <strong>Administrador</strong>
                            <small class="text-muted ms-1">(acesso total — ignora perfis de acesso)</small>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3" id="painelPerfis">
        <div class="card-header fw-semibold">
            <i class="bi bi-shield-lock me-2"></i>Perfis de Acesso
        </div>
        <div class="card-body p-0">
            @if (!Model.Perfis.Any())
            {
                <div class="p-3 text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    Nenhum perfil cadastrado.
                    <a asp-controller="Perfis" asp-action="Index">Cadastre perfis</a> antes de criar usuários.
                </div>
            }
            else
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:50px" class="text-center">Acesso</th>
                            <th style="width:20%">Código</th>
                            <th>Descrição</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Perfis.Count; i++)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <input type="hidden" asp-for="Perfis[i].IdPerfil" />
                                    <input type="hidden" asp-for="Perfis[i].Codigo" />
                                    <input type="hidden" asp-for="Perfis[i].Descricao" />
                                    <input asp-for="Perfis[i].Selecionado" type="checkbox"
                                           class="form-check-input cb-perfil" />
                                </td>
                                <td class="align-middle fw-semibold">@Model.Perfis[i].Codigo</td>
                                <td class="align-middle">@Model.Perfis[i].Descricao</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Salvar
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
<script>
    const chkAdmin   = document.getElementById('chkIsAdmin');
    const painelPerf = document.getElementById('painelPerfis');

    function atualizarPainel() {
        painelPerf.style.opacity = chkAdmin.checked ? '0.4' : '1';
        painelPerf.querySelectorAll('.cb-perfil').forEach(cb => cb.disabled = chkAdmin.checked);
    }

    chkAdmin.addEventListener('change', atualizarPainel);
    atualizarPainel();

    document.getElementById('inp-codigo')?.addEventListener('input', function () {
        this.value = this.value.toUpperCase();
    });
</script>
}
