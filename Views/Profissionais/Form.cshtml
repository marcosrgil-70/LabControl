@model ProfissionalVM
@inject IEmpresaContexto Usuario
@{
    var inclusao = Model.Id == 0;
    ViewData["Title"] = inclusao ? "Novo profissional" : Model.Nome;
    var contatos = ViewData["Contatos"] as ContatosVM;
    var podeGravar = Usuario.TemPermissao(inclusao ? "PROFISSIONAIS.INCLUIR" : "PROFISSIONAIS.ALTERAR");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small mb-2">
        <li class="breadcrumb-item"><a asp-action="Index">Profissionais</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(inclusao ? "Novo" : $"{Model.Nome} {Model.Sobrenome}")</li>
    </ol>
</nav>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#aba-dados" type="button" role="tab">Dados do profissional</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#aba-enderecos" type="button" role="tab" disabled="@inclusao">Endereços <span class="badge text-bg-light border" data-contagem="enderecos"></span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#aba-telefones" type="button" role="tab" disabled="@inclusao">Telefones <span class="badge text-bg-light border" data-contagem="telefones"></span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#aba-emails" type="button" role="tab" disabled="@inclusao">E-mails <span class="badge text-bg-light border" data-contagem="emails"></span></button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="aba-dados" role="tabpanel">
        <form method="post" asp-action="@(inclusao ? "Criar" : "Editar")" asp-route-id="@(inclusao ? null : Model.Id)" enctype="multipart/form-data" novalidate>
            <fieldset disabled="@(!podeGravar)">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                @if (inclusao)
                {
                    <div class="alert alert-info py-2 small"><i class="bi bi-info-circle me-1"></i>Grave os dados para liberar as abas de endereços, telefones e e-mails.</div>
                }
                <div class="card mb-3">
                    <div class="card-header fw-semibold py-2">Identificação</div>
                    <div class="card-body row g-3">
                        <div class="col-md-5">
                            <label asp-for="Nome" class="form-label small">Nome *</label>
                            <input asp-for="Nome" class="form-control text-uppercase" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Sobrenome" class="form-label small"></label>
                            <input asp-for="Sobrenome" class="form-control text-uppercase" />
                            <div class="form-text">O boletim imprime nome + sobrenome.</div>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="Inativo" class="form-check-input" />
                                <label asp-for="Inativo" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Cpf" class="form-label small"></label>
                            <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" />
                            <span asp-validation-for="Cpf" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Rg" class="form-label small"></label>
                            <input asp-for="Rg" class="form-control text-uppercase" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdCargosFuncionarios" class="form-label small"></label>
                            <select asp-for="IdCargosFuncionarios" lc-rapido="CARGOS_FUNCIONARIOS" asp-items="@(new SelectList(Model.Cargos, "Id", "Nome"))" class="form-select"><option value="">—</option></select>
                            <div class="form-text">Impresso no boletim.</div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header fw-semibold py-2">Laboratório</div>
                    <div class="card-body row g-3">
                        <div class="col-md-4">
                            <label asp-for="IdTiposRegProfissional" class="form-label small"></label>
                            <select asp-for="IdTiposRegProfissional" lc-rapido="TIPOS_REG_PROFISSIONAL" asp-items="@(new SelectList(Model.TiposRegistro, "Id", "Nome"))" class="form-select"><option value="">—</option></select>
                            <span asp-validation-for="IdTiposRegProfissional" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NrRegistroProfissional" class="form-label small"></label>
                            <input asp-for="NrRegistroProfissional" class="form-control text-uppercase" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="UfRegistro" class="form-label small"></label>
                            <select asp-for="UfRegistro" asp-items="@(new SelectList(Model.Ufs))" class="form-select"><option value="">—</option></select>
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-4">
                            <div class="form-check">
                                <input asp-for="AssinaBoletim" class="form-check-input" />
                                <label asp-for="AssinaBoletim" class="form-check-label"></label>
                                <div class="form-text">Aparece como Responsável 1/2 do boletim; exige tipo, nº e UF do registro.</div>
                            </div>
                            <div class="form-check">
                                <input asp-for="ExecutaAnalise" class="form-check-input" />
                                <label asp-for="ExecutaAnalise" class="form-check-label"></label>
                                <div class="form-text">Aparece como analista nos resultados.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NovaAssinatura" class="form-label small"></label>
                            @if (Model.TemAssinatura)
                            {
                                <div class="mb-2"><img src="@Url.Action("Assinatura", new { id = Model.Id })" alt="Assinatura atual" class="border rounded p-1 bg-white" style="max-height: 80px" /></div>
                                <div class="form-check small mb-2">
                                    <input asp-for="RemoverAssinatura" class="form-check-input" />
                                    <label asp-for="RemoverAssinatura" class="form-check-label"></label>
                                </div>
                            }
                            <input asp-for="NovaAssinatura" type="file" class="form-control form-control-sm" accept="image/png" />
                            <span asp-validation-for="NovaAssinatura" class="text-danger small"></span>
                            <div class="form-text">Impressa só no PDF do boletim emitido.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdUsuario" class="form-label small"></label>
                            <select asp-for="IdUsuario" asp-items="@(new SelectList(Model.Usuarios, "Id", "Nome"))" class="form-select"><option value="">— sem usuário —</option></select>
                            <span asp-validation-for="IdUsuario" class="text-danger small"></span>
                            <div class="form-text">Usuários com acesso a esta empresa e ainda sem profissional. O usuário passa a ser este profissional (digitador/recebedor). Profissional inativo fica sem usuário. Não achou o usuário? Em <a asp-controller="Usuarios" asp-action="Index">Usuários</a>, marque o acesso dele a esta empresa.</div>
                        </div>
                    </div>
                </div>
                @if (podeGravar)
                {
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Gravar dados</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                    </div>
                }
            </fieldset>
            @if (!podeGravar)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
            }
        </form>
    </div>

    @if (contatos is not null)
    {
        <partial name="_ContatosAbas" model="contatos" />
    }
</div>

@if (contatos is not null)
{
    <partial name="_ContatosModais" model="contatos" />
}

@section Scripts {
    <script src="~/js/contatos.js" asp-append-version="true"></script>
    <script>
        const aba = location.hash && document.querySelector(`[data-bs-target="${location.hash}"]:not([disabled])`);
        if (aba) bootstrap.Tab.getOrCreateInstance(aba).show();
    </script>
}
