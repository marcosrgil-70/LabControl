@model EmpresaVM
@{
    ViewData["Title"] = "Empresa";
}

<h5 class="mb-3"><i class="bi bi-building-gear me-2 text-primary"></i>Dados da empresa <span class="badge text-bg-secondary">@Model.CodEmpresa</span></h5>

<form method="post" asp-action="Dados" enctype="multipart/form-data" novalidate>
    <partial name="_EmpresaCampos" model="Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" lc-permissao="EMPRESAS.ALTERAR"><i class="bi bi-check-lg me-1"></i>Gravar</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</form>
