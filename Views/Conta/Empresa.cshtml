@model EscolherEmpresaVM
@{
    ViewData["Title"] = "Empresa";
    Layout = "_LayoutConta";
}

<h6 class="fw-semibold mb-3"><i class="bi bi-building me-1"></i>Selecione a empresa</h6>

<form asp-action="Empresa" method="post" novalidate>
    <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3"></div>

    <div class="list-group mb-4">
        @foreach (var e in Model.Empresas)
        {
            <label class="list-group-item d-flex align-items-center gap-2">
                <input type="radio" class="form-check-input m-0" name="IdEmpresa" value="@e.IdEmpresas" checked="@(e.IdEmpresas == Model.IdEmpresa)" />
                <span class="badge text-bg-secondary">@e.Codigo</span>
                <span class="flex-grow-1">@e.Nome</span>
                @if (e.IdEmpresas == Model.EmpresaAtual)
                {
                    <span class="badge text-bg-primary">atual</span>
                }
            </label>
        }
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-box-arrow-in-right me-1"></i>Entrar</button>
        @if (Model.EmpresaAtual is not null)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        }
        else
        {
            <button type="submit" form="form-sair" class="btn btn-outline-secondary">Sair</button>
        }
    </div>
</form>
<form id="form-sair" asp-action="Sair" method="post"></form>
