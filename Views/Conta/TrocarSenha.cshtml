@model TrocarSenhaVM
@{
    ViewData["Title"] = "Trocar senha";
    Layout = "_LayoutConta";
}

<h6 class="fw-semibold mb-1"><i class="bi bi-key me-1"></i>Trocar senha</h6>
@if (Model.Obrigatoria)
{
    <p class="small text-muted">Defina uma nova senha para continuar (primeiro acesso ou senha provisória).</p>
}

<form asp-action="TrocarSenha" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="mb-3">
        <label asp-for="SenhaAtual" class="form-label small"></label>
        <input asp-for="SenhaAtual" class="form-control" autocomplete="current-password" autofocus />
        <span asp-validation-for="SenhaAtual" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NovaSenha" class="form-label small"></label>
        <input asp-for="NovaSenha" class="form-control" autocomplete="new-password" />
        <div class="form-text">Mínimo de 8 caracteres, com letras e números.</div>
        <span asp-validation-for="NovaSenha" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Confirmacao" class="form-label small"></label>
        <input asp-for="Confirmacao" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Confirmacao" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-check-lg me-1"></i>Gravar</button>
        @if (Model.Obrigatoria)
        {
            <button type="submit" form="form-sair" class="btn btn-outline-secondary">Sair</button>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        }
    </div>
</form>
<form id="form-sair" asp-action="Sair" method="post"></form>
