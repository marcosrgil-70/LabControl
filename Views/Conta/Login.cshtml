@model LoginVM
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LayoutConta";
}

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Login" class="form-label fw-semibold small"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person"></i></span>
            <input asp-for="Login" class="form-control text-uppercase" autocomplete="username" autofocus />
        </div>
        <span asp-validation-for="Login" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Senha" class="form-label fw-semibold small"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input asp-for="Senha" class="form-control" autocomplete="current-password" />
        </div>
        <span asp-validation-for="Senha" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-1"></i>Entrar</button>
</form>
