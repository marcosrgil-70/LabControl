@model PedidoVendaListaVM
@using LabControl.Models
@{
    ViewData["Title"] = "Pedidos de venda";
    var f = Model.Filtro;
    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    // filtros atuais + página (sem os vazios) para os links da paginação
    Dictionary<string, string> Rota(int pagina) => new Dictionary<string, string?>
    {
        ["NrPedido"] = f.NrPedido?.ToString(), ["Cliente"] = f.Cliente, ["Proposta"] = f.Proposta, ["Situacao"] = f.Situacao?.ToString(),
        ["De"] = f.De?.ToString("yyyy-MM-dd"), ["Ate"] = f.Ate?.ToString("yyyy-MM-dd"), ["Pagina"] = pagina.ToString(),
    }.Where(kv => kv.Value is not null).ToDictionary(kv => kv.Key, kv => kv.Value!);
}

<div class="d-flex align-items-center mb-1">
    <h5 class="mb-0"><i class="bi bi-cart-check me-2 text-primary"></i>Pedidos de venda</h5>
</div>
<p class="small text-body-secondary mb-3">Pedido gerado a partir da proposta autorizada pelo cliente (botão "Gerar pedido" na proposta). Acompanha o contratado × recebido e conclui sozinho quando todos os itens foram recebidos e os boletins emitidos.</p>

<form method="get" class="card mb-3" id="filtroPedidos">
    <div class="card-body py-2 row g-2 align-items-end">
        <div class="col-6 col-sm-2 col-lg-1">
            <label class="form-label small mb-0" for="NrPedido">Nº pedido</label>
            <input name="NrPedido" id="NrPedido" value="@f.NrPedido" type="number" min="1" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4 col-lg-3">
            <label class="form-label small mb-0" for="Cliente">Cliente (nome ou CPF/CNPJ)</label>
            <input name="Cliente" id="Cliente" value="@f.Cliente" class="form-control form-control-sm" autofocus />
        </div>
        <div class="col-6 col-sm-2">
            <label class="form-label small mb-0" for="Proposta">Nº da proposta</label>
            <input name="Proposta" id="Proposta" value="@f.Proposta" class="form-control form-control-sm font-monospace" placeholder="123/26" />
        </div>
        <div class="col-sm-4 col-lg-2">
            <label class="form-label small mb-0" for="Situacao">Situação</label>
            <select name="Situacao" id="Situacao" class="form-select form-select-sm">
                <option value="">Todas</option>
                @foreach (var s in Enum.GetValues<SituacaoPedido>())
                {
                    <option value="@s" selected="@(f.Situacao == s)">@SituacoesPedido.Nome(s)</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm-3 col-lg-1">
            <label class="form-label small mb-0" for="De">De</label>
            <input name="De" id="De" type="date" value="@f.De?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-sm-3 col-lg-1">
            <label class="form-label small mb-0" for="Ate">Até</label>
            <input name="Ate" id="Ate" type="date" value="@f.Ate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search me-1"></i>Pesquisar</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead>
                <tr><th>Nº pedido</th><th>Data</th><th>Proposta</th><th>CPF/CNPJ</th><th>Cliente</th><th class="text-end">Valor</th><th>Situação</th><th class="text-end">Recebidas</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Itens)
                {
                    <tr>
                        <td class="font-monospace small"><a asp-action="Editar" asp-route-id="@p.Id" class="text-decoration-none fw-semibold">@p.NrPedido</a></td>
                        <td class="small">@p.DtPedido.ToString("dd/MM/yyyy")</td>
                        <td class="font-monospace small text-nowrap">@p.NrProposta</td>
                        <td class="small font-monospace text-nowrap">@p.CpfCnpj</td>
                        <td class="small">@p.Cliente</td>
                        <td class="small text-end text-nowrap">@p.VrTotal.ToString("N2", br)</td>
                        <td><span class="badge @SituacoesPedido.Classe(p.Situacao)">@SituacoesPedido.Nome(p.Situacao)</span></td>
                        <td class="small text-end text-nowrap @(p.Recebidas > p.Contratadas ? "text-danger fw-semibold" : "")">@p.Recebidas / @p.Contratadas</td>
                        <td class="text-end"><a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye me-1"></i>Abrir</a></td>
                    </tr>
                }
                @if (Model.Itens.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-body-secondary small py-3">Nenhum pedido encontrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex align-items-center small py-2">
        <span class="text-body-secondary">@Model.Total registro(s)</span>
        @if (Model.Paginas > 1)
        {
            <nav class="ms-auto" aria-label="Páginas">
                <ul class="pagination pagination-sm mb-0">
                    @foreach (var n in Enumerable.Range(1, Model.Paginas).Where(n => n <= 3 || n > Model.Paginas - 3 || Math.Abs(n - f.Pagina) <= 2))
                    {
                        <li class="page-item @(n == f.Pagina ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="@Rota(n)">@n</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
