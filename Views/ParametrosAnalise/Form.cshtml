@model ParametroAnaliseVM
@inject IEmpresaContexto Usuario
@{
    var inclusao = Model.Id == 0;
    ViewData["Title"] = inclusao ? "Novo parâmetro de análise" : Model.Descricao;
    var podeGravar = Usuario.TemPermissao(inclusao ? "PARAMETROS_ANALISE.INCLUIR" : "PARAMETROS_ANALISE.ALTERAR");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small mb-2">
        <li class="breadcrumb-item"><a asp-action="Index">Parâmetros de análise</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(inclusao ? "Novo" : Model.Descricao)</li>
    </ol>
</nav>

<form method="post" asp-action="@(inclusao ? "Criar" : "Editar")" asp-route-id="@(inclusao ? null : Model.Id)" id="formParametro" novalidate style="max-width: 56rem">
    <fieldset disabled="@(!podeGravar)">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="card mb-3">
            <div class="card-body row g-3">
                <div class="col-sm-7">
                    <label asp-for="Descricao" class="form-label small"></label> <span class="text-danger">*</span>
                    <input asp-for="Descricao" class="form-control text-uppercase" maxlength="150" autofocus />
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>
                <div class="col-sm-5">
                    <label asp-for="DescReduzida" class="form-label small"></label> <span class="text-danger">*</span>
                    <input asp-for="DescReduzida" class="form-control text-uppercase" maxlength="150" />
                    <span asp-validation-for="DescReduzida" class="text-danger small"></span>
                    <div class="form-text">Texto impresso no boletim.</div>
                </div>
                <div class="col-sm-6">
                    <label asp-for="IdAnalisesTipo" class="form-label small"></label> <span class="text-danger">*</span>
                    <select asp-for="IdAnalisesTipo" lc-rapido="ANALISES_TIPO" asp-items="@(new SelectList(Model.Tipos, "Id", "Nome"))" class="form-select"><option value="">—</option></select>
                    <span asp-validation-for="IdAnalisesTipo" class="text-danger small"></span>
                    <div class="form-text">Define o tipo dos testes da amostra.</div>
                </div>
                <div class="col-sm-3">
                    <label asp-for="VrUnitario" class="form-label small"></label>
                    <input asp-for="VrUnitario" class="form-control text-end" inputmode="decimal" placeholder="0,00" />
                    <span asp-validation-for="VrUnitario" class="text-danger small"></span>
                    <div class="form-text">Sugerido na proposta.</div>
                </div>
                <div class="col-sm-3 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input asp-for="Auditado" class="form-check-input" />
                        <label asp-for="Auditado" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label asp-for="IdAnalisesMetodos" class="form-label small"></label>
                    <select asp-for="IdAnalisesMetodos" lc-rapido="ANALISES_METODOS" asp-items="@(new SelectList(Model.Metodos, "Id", "Nome"))" class="form-select"><option value="">—</option></select>
                    <span asp-validation-for="IdAnalisesMetodos" class="text-danger small"></span>
                    <div class="form-text">Na proposta, o combo de método vem filtrado por ele.</div>
                </div>
                <div class="col-sm-6">
                    <label asp-for="DescrMetodo" class="form-label small"></label>
                    <input asp-for="DescrMetodo" class="form-control text-uppercase" maxlength="150" />
                    <span asp-validation-for="DescrMetodo" class="text-danger small"></span>
                    <div class="form-text">Início da linha de metodologia no boletim ("DESCRIÇÃO: método").</div>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="Inativo" class="form-check-input" />
                        <label asp-for="Inativo" class="form-check-label">Inativo (some da proposta)</label>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        @if (podeGravar)
        {
            <button type="submit" class="btn btn-primary ms-auto"><i class="bi bi-check-lg me-1"></i>Gravar</button>
        }
    </div>
</form>
