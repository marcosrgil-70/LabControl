@model LabControl.Models.Laboratorio.HistAmostra
@using LabControl.Models.Entidades
@using LabControl.Models.Laboratorio
@{
    ViewData["Title"] = $"Editar Amostra {Model.CodigoFormatado}";
    var clientes     = ViewBag.Clientes    as List<Entidade>             ?? [];
    var propostas    = ViewBag.Propostas   as List<Proposta>             ?? [];
    var produtos     = ViewBag.Produtos    as List<Produto>              ?? [];
    var tiposAmostra = ViewBag.AmostrasTipos as List<AmostraTipo>        ?? [];
    var tiposAnalise = ViewBag.AnalisesTipos as List<AnaliseTipo>        ?? [];
    var embalagens   = ViewBag.EmbalagensTopos as List<EmbalagemTipo>    ?? [];
    var statusLista  = ViewBag.AmostrasStatus as List<AmostraStatus>     ?? [];
    var funcionarios = ViewBag.Funcionarios as List<EntidadeFuncionario> ?? [];

    var meses = new[] { "Janeiro","Fevereiro","Março","Abril","Maio","Junho",
                        "Julho","Agosto","Setembro","Outubro","Novembro","Dezembro" };
    var anoAtual = DateTime.Now.Year;
    var anos = Enumerable.Range(anoAtual - 10, 16).Reverse();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0"><i class="bi bi-droplet-fill me-2 text-warning"></i>Editar Amostra</h5>
        <small class="text-muted">Alteração dos dados de recebimento</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Detalhes" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-eye me-1"></i>Detalhes
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger py-2 small mb-3">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@err.ErrorMessage</div>
        }
    </div>
}

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CodAmostra" />
    <input type="hidden" asp-for="IdEmpresa" />
    <input type="hidden" asp-for="IdFuncionarioDigitador" />

    <!-- Código da amostra (read-only) -->
    <div class="card mb-3">
        <div class="card-body py-2 d-flex align-items-center gap-3">
            <span class="fw-semibold text-muted small">Código da Amostra:</span>
            <span class="fs-5 fw-bold text-primary font-monospace">@Model.CodigoFormatado</span>
            <span class="text-muted small ms-3">Revisão: @(Model.Revisao ?? 0)</span>
        </div>
    </div>

    <!-- Abas -->
    <ul class="nav nav-tabs mb-0" id="tabsAmostra">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#tabGeral">
                <i class="bi bi-info-circle me-1"></i>Informações Gerais
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tabObservacao">
                <i class="bi bi-chat-text me-1"></i>Observação
            </a>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white mb-3">

        <!-- ABA: Informações Gerais -->
        <div class="tab-pane fade show active" id="tabGeral">
            <div class="row g-3">

                <div class="col-md-5">
                    <label class="form-label">Cliente <span class="text-danger">*</span></label>
                    <select id="selCliente" name="IdEntidade" class="form-select form-select-sm" required>
                        <option value="">— Selecione o cliente —</option>
                        @foreach (var c in clientes)
                        {
                            <option value="@c.Id" selected="@(Model.IdEntidade == c.Id)">@c.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Proposta <span class="text-danger">*</span></label>
                    <select id="selProposta" name="IdProposta" class="form-select form-select-sm" required>
                        <option value="">— Selecione —</option>
                        @foreach (var p in propostas)
                        {
                            <option value="@p.Id" selected="@(Model.IdProposta == p.Id)">@p.CodProposta/@p.AnoProposta</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nome do Contato</label>
                    <input asp-for="NomeContato" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Data de Entrega <span class="text-danger">*</span></label>
                    <input asp-for="DtEntrega" type="date" class="form-control form-control-sm"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hora <span class="text-danger">*</span></label>
                    <input asp-for="HrEntrega" type="time" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Local de Recebimento</label>
                    <input asp-for="LocalRecebimento" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Pedido de Venda</label>
                    <input asp-for="PedidoVenda" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tipo Documento</label>
                    <input asp-for="TipoDocumento" class="form-control form-control-sm" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Tipo de Embalagem <span class="text-danger">*</span></label>
                    <select asp-for="IdEmbalagemTipo" class="form-select form-select-sm" required>
                        <option value="">— Selecione —</option>
                        @foreach (var e in embalagens)
                        {
                            <option value="@e.Id">@e.Descricao</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Qtde Embalagens</label>
                    <input asp-for="QtdeEmbalagensEntregue" class="form-control form-control-sm" type="number" min="1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Responsável <span class="text-danger">*</span></label>
                    <select asp-for="IdFuncionarioResp" class="form-select form-select-sm" required>
                        <option value="">— Selecione —</option>
                        @foreach (var f in funcionarios)
                        {
                            <option value="@f.Id">@f.Entidade?.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status da Amostra <span class="text-danger">*</span></label>
                    <select asp-for="IdAmostraStatus" class="form-select form-select-sm" required>
                        <option value="">— Selecione —</option>
                        @foreach (var s in statusLista)
                        {
                            <option value="@s.Id">@s.Descricao</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Produto</label>
                    <select id="selProduto" name="IdProduto" class="form-select form-select-sm">
                        <option value="">— Selecione a proposta primeiro —</option>
                        @foreach (var p in produtos)
                        {
                            <option value="@p.Id" selected="@(Model.IdProduto == p.Id)">@p.Descricao</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tipo de Amostra <span class="text-danger">*</span></label>
                    <select asp-for="IdAmostraTipo" class="form-select form-select-sm" required>
                        <option value="">— Selecione —</option>
                        @foreach (var t in tiposAmostra)
                        {
                            <option value="@t.Id">@t.Descricao</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tipo de Análise <span class="text-danger">*</span></label>
                    <select id="selAnaliseTipo" asp-for="IdAnaliseTipo" class="form-select form-select-sm" required>
                        <option value="">— Selecione —</option>
                        @foreach (var t in tiposAnalise)
                        {
                            <option value="@t.Id">@t.Descricao</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Nº Lote</label>
                    <input asp-for="NrLote" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Nota / Rótulo</label>
                    <input asp-for="NotaRotulo" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Espécie</label>
                    <input asp-for="EspecieAmostra" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Aspecto</label>
                    <input asp-for="AspectoAmostra" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cor</label>
                    <input asp-for="Cor" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Outras Características</label>
                    <input asp-for="OutrasCaracteristicas" class="form-control form-control-sm" />
                </div>

                <!-- Fabricação (Dia / Mês / Ano) -->
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-4 align-items-end">
                        <div>
                            <label class="form-label mb-1">Fabricação</label>
                            <div class="d-flex gap-1">
                                <select asp-for="FabricacaoDia" class="form-select form-select-sm" style="width:72px">
                                    <option value="">Dia</option>
                                    @for (int d = 1; d <= 31; d++)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                                <select asp-for="FabricacaoMes" class="form-select form-select-sm" style="width:125px">
                                    <option value="">Mês</option>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">@meses[m - 1]</option>
                                    }
                                </select>
                                <select asp-for="FabricacaoAno" class="form-select form-select-sm" style="width:90px">
                                    <option value="">Ano</option>
                                    @foreach (var a in anos)
                                    {
                                        <option value="@a">@a</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="form-label mb-1">Validade</label>
                            <div class="d-flex gap-1">
                                <select asp-for="ValidadeDia" class="form-select form-select-sm" style="width:72px">
                                    <option value="">Dia</option>
                                    @for (int d = 1; d <= 31; d++)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                                <select asp-for="ValidadeMes" class="form-select form-select-sm" style="width:125px">
                                    <option value="">Mês</option>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">@meses[m - 1]</option>
                                    }
                                </select>
                                <select asp-for="ValidadeAno" class="form-select form-select-sm" style="width:90px">
                                    <option value="">Ano</option>
                                    @foreach (var a in anos)
                                    {
                                        <option value="@a">@a</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Qtde Amostra Verificação</label>
                    <input asp-for="QtdeAmostraVerificacao" class="form-control form-control-sm" type="number" step="0.01" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Temperatura (°C)</label>
                    <input asp-for="TemperaturaVerificacao" class="form-control form-control-sm" type="number" step="0.1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Data/Hora Coleta</label>
                    <input asp-for="DtHrColeta" type="datetime-local" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nome do Coletor</label>
                    <input asp-for="NomeColetor" class="form-control form-control-sm" />
                </div>

                <div class="col-12">
                    <label class="form-label d-block">Documentos Acompanhantes</label>
                    <div class="d-flex flex-wrap gap-4">
                        <div class="form-check">
                            <input asp-for="AcompanhaFichaTecnica" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Ficha Técnica</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="AcompanhaPadraoAnalitico" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Padrão Analítico</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="AcompanhaCaCliente" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">CA do Cliente</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="EnviarOutroLaboratorio" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Enviar a outro laboratório</label>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ABA: Observação -->
        <div class="tab-pane fade" id="tabObservacao">
            <div class="row g-2">
                <div class="col-12">
                    <label class="form-label">Observação da Verificação</label>
                    <textarea asp-for="Observacao" class="form-control" rows="12"
                              placeholder="Observações sobre a verificação da amostra..."></textarea>
                </div>
            </div>
        </div>

    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Detalhes" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-warning">
            <i class="bi bi-save me-1"></i>Salvar Alterações
        </button>
    </div>
</form>

@section Scripts {
<script>
    const urlPropostas = '@Url.Action("PropostasPorCliente", "HistAmostras")';
    const urlProdutos  = '@Url.Action("ProdutosPorProposta", "HistAmostras")';
    const urlAnalises  = '@Url.Action("AnaliseTiposPorProposta", "HistAmostras")';

    const selCliente  = document.getElementById('selCliente');
    const selProposta = document.getElementById('selProposta');
    const selProduto  = document.getElementById('selProduto');
    const selAnalise  = document.getElementById('selAnaliseTipo');

    function preencherSelect(sel, itens, textoVazio) {
        const valAtual = sel.value;
        sel.innerHTML = `<option value="">${textoVazio}</option>`;
        itens.forEach(i => {
            const opt = document.createElement('option');
            opt.value = i.id;
            opt.textContent = i.texto;
            if (String(i.id) === valAtual) opt.selected = true;
            sel.appendChild(opt);
        });
    }

    selCliente.addEventListener('change', async function () {
        const id = this.value;
        selProposta.innerHTML = '<option value="">Carregando...</option>';
        selProduto.innerHTML  = '<option value="">— Selecione a proposta primeiro —</option>';
        selAnalise.innerHTML  = '<option value="">— Selecione —</option>';
        if (!id) { selProposta.innerHTML = '<option value="">— Selecione —</option>'; return; }
        const data = await fetch(`${urlPropostas}?idCliente=${id}`).then(r => r.json());
        preencherSelect(selProposta, data, '— Selecione a proposta —');
    });

    selProposta.addEventListener('change', async function () {
        const id = this.value;
        selProduto.innerHTML = '<option value="">Carregando...</option>';
        selAnalise.innerHTML = '<option value="">— Selecione —</option>';
        if (!id) { selProduto.innerHTML = '<option value="">— Selecione a proposta primeiro —</option>'; return; }
        const data = await fetch(`${urlProdutos}?idProposta=${id}`).then(r => r.json());
        preencherSelect(selProduto, data, '— Selecione o produto —');
    });

    selProduto.addEventListener('change', async function () {
        const idProp = selProposta.value;
        const idProd = this.value;
        selAnalise.innerHTML = '<option value="">Carregando...</option>';
        if (!idProp || !idProd) { selAnalise.innerHTML = '<option value="">— Selecione —</option>'; return; }
        const data = await fetch(`${urlAnalises}?idProposta=${idProp}&idProduto=${idProd}`).then(r => r.json());
        preencherSelect(selAnalise, data, '— Selecione —');
    });
</script>
}
