@model LabControl.Models.Laboratorio.ParametroAnalise
@using LabControl.Models.Laboratorio

@{
    var metodos = ViewBag.AnalisesMetodos as List<AnaliseMetodo> ?? [];
    var tipos   = ViewBag.AnalisesTipos  as List<AnaliseTipo>   ?? [];
}

<ul class="nav nav-tabs mb-0">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#tabDados">
            <i class="bi bi-sliders me-1"></i>Dados Gerais
        </a>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom p-3 bg-white mb-3">
    <div class="tab-pane fade show active" id="tabDados">
        <div class="row g-3">

            <div class="col-12">
                <label class="form-label">Descrição <span class="text-danger">*</span></label>
                <input asp-for="Descricao" class="form-control form-control-sm"
                       placeholder="Nome completo do parâmetro/ensaio conforme laudo"
                       required maxlength="150" />
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Descrição Reduzida</label>
                <input asp-for="DescReduzida" class="form-control form-control-sm"
                       placeholder="Nome abreviado (ex: para impressão)" maxlength="80" />
                <small class="text-muted">Versão curta usada em relatórios compactos</small>
            </div>

            <div class="col-md-3">
                <label class="form-label">Tipo de Análise</label>
                <select asp-for="IdAnaliseTipo" class="form-select form-select-sm">
                    <option value="">— Não vinculado —</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t.Id">@t.Descricao</option>
                    }
                </select>
                <small class="text-muted">Facilita filtragem nas propostas</small>
            </div>

            <div class="col-md-3">
                <label class="form-label">Método de Análise</label>
                <select asp-for="IdAnaliseMetodo" class="form-select form-select-sm">
                    <option value="">— Não vinculado —</option>
                    @foreach (var m in metodos)
                    {
                        <option value="@m.Id">@m.Descricao</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Valor Unitário (R$) <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">R$</span>
                    <input asp-for="VrUnitario" type="number" step="0.01" min="0"
                           class="form-control" placeholder="0,00" required id="inpVrUnit" />
                </div>
                <span asp-validation-for="VrUnitario" class="text-danger small"></span>
                <small class="text-muted">Valor padrão ao adicionar em propostas</small>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="Auditado" class="form-check-input" type="checkbox" id="chkAuditado" />
                    <label class="form-check-label" for="chkAuditado">
                        <i class="bi bi-patch-check me-1 text-success"></i>Auditado
                    </label>
                    <div><small class="text-muted">Método submetido a auditoria externa</small></div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('inpVrUnit').addEventListener('input', function () {
        const val = parseFloat(this.value) || 0;
        // preview only if element exists
    });
</script>
}
