@model IReadOnlyList<EmpresaListaItemVM>
@{
    ViewData["Title"] = "Empresas";
}

<div class="d-flex align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-buildings me-2 text-primary"></i>Empresas</h5>
    <a asp-action="Criar" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg me-1"></i>Nova empresa</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead><tr><th>Código</th><th>Empresa</th><th>CNPJ</th><th>Cidade</th><th class="text-end">Usuários</th><th>Situação</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><span class="badge text-bg-secondary">@e.Codigo</span></td>
                        <td class="fw-semibold">@e.Nome</td>
                        <td class="small">@e.Cnpj</td>
                        <td class="small">@e.Cidade</td>
                        <td class="text-end">@e.Usuarios</td>
                        <td>@if (e.Ativa) { <span class="badge text-bg-success">Ativa</span> } else { <span class="badge text-bg-secondary">Inativa</span> }</td>
                        <td class="text-end"><a asp-action="Editar" asp-route-id="@e.Id" class="btn btn-outline-secondary btn-sm" title="Alterar"><i class="bi bi-pencil"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
