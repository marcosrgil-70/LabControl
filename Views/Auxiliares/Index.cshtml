@using LabControl.Services.Auxiliares
@model IReadOnlyList<AuxiliarDefinicao>
@{
    ViewData["Title"] = "Cadastros auxiliares";
}

<h5 class="mb-3"><i class="bi bi-tags me-2 text-primary"></i>Cadastros auxiliares</h5>

<div class="row g-3">
    @foreach (var d in Model.OrderBy(d => d.Titulo))
    {
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <a asp-action="Lista" asp-route-tabela="@d.Tabela" class="card h-100 text-decoration-none auxiliar-card">
                <div class="card-body d-flex gap-3 align-items-start">
                    <i class="bi @d.Icone fs-4 text-primary"></i>
                    <div>
                        <div class="fw-semibold text-body">@d.Titulo</div>
                        @if (d.Ajuda is not null)
                        {
                            <div class="small text-body-secondary">@d.Ajuda</div>
                        }
                    </div>
                </div>
            </a>
        </div>
    }
</div>
